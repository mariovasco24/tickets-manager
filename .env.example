# =============================================================================
# Bugs Manager — configuración por variables de entorno
# Copia este archivo a .env y rellena los valores. Nada se hardcodea en el código.
# La guía paso a paso para obtener cada credencial está en README.md.
# =============================================================================

# --- Servicio ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# URL pública con la que Jira (y Slack en modo HTTP) alcanzan este servicio.
# En local es la URL del túnel (cloudflared). En el VPS, tu dominio.
# Solo informativa en Socket Mode; obligatoria en la práctica si SLACK_SOCKET_MODE=false.
PUBLIC_BASE_URL=
# URL con la que TÚ abres el dashboard; se usa en los enlaces que el bot pone en Slack.
# En local: http://localhost:3000. Si falta, se usa PUBLIC_BASE_URL y, si tampoco, localhost:PORT.
DASHBOARD_URL=http://localhost:3000

# --- Jira Cloud (SOLO LECTURA: nunca cambiamos estados ni editamos tickets) ---
JIRA_BASE_URL=https://qrveydev.atlassian.net
# Email de la cuenta Atlassian con la que se creó el API token.
JIRA_EMAIL=tu.email@qrvey.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# OPCIONAL. Registrar el webhook requiere ser administrador de Jira. Si lo dejas vacío,
# la ruta /webhooks/jira no se monta y el disparo es solo manual desde Slack.
# Cuando lo tengas: es el "Secret" del webhook (Settings → System → Webhooks). Jira firma
# cada petición con HMAC-SHA256 en la cabecera X-Hub-Signature. Genera uno con: openssl rand -hex 32
JIRA_WEBHOOK_SECRET=
# PRÓXIMO (aún no implementado): alternativa al webhook sin permisos de admin. Sondeo por JQL
# cada X segundos que toma los bugs nuevos que aún no gestionamos. 0 = desactivado.
# JIRA_POLL_INTERVAL_SECONDS=0
# JIRA_POLL_JQL=project = AN AND issuetype = Bug AND statusCategory != Done ORDER BY created DESC
# Tipos de issue que dispara el webhook (separados por coma). El servicio no está atado a ningún
# proyecto de Jira: /fix, las menciones y el webhook aceptan cualquier clave (XYZ-123). El repositorio
# donde se arregla lo determina el triaje sobre el catálogo, o las notas del /fix si indicas el repo.
JIRA_BUG_ISSUE_TYPES=Bug
# ÚNICA escritura en Jira: al empezar, el bot pregunta si mover el ticket al estado de trabajo
# en curso. Si respondes que no, no toca nada. Nunca comenta ni edita campos.
# Requiere que tu cuenta tenga permiso para transicionar en ese proyecto.
JIRA_ALLOW_TRANSITION=true
JIRA_IN_PROGRESS_STATUS=In Progress
# Al terminar el fix, ofrece publicar el reporte (Issue/Solution/Notes for QA/rama/archivos/tests/
# reproducción/PR) como comentario del ticket, con los vídeos de antes y después adjuntos.
# También se pregunta siempre antes de escribir.
JIRA_ALLOW_COMMENT=true
# Tras abrir el PR, ofrece mover el ticket a este estado (tercera y última escritura, también
# confirmada). Vacío = no se ofrece. Flujo del equipo: Open → In Progress → Waiting for Merge → Ready for QA Build.
JIRA_WAITING_FOR_MERGE_STATUS=Waiting for Merge

# --- Pull request (Bitbucket Cloud) ------------------------------------------
# Con el fix listo, el bot pregunta si sube la rama y abre el PR hacia la rama origen. Al confirmar:
# commitea los cambios del worktree con COMMIT_MESSAGE_TEMPLATE (pasando por los hooks del repo),
# sube la rama con su MISMO nombre y deja el PR abierto. NUNCA empuja a la rama origen ni mergea.
# El enlace del PR va al hilo, al dashboard y al comentario de Jira.
PR_ENABLED=true
# Bitbucket borra la rama bugfix/… al mergear el PR (las ramas llevan timestamp, no se reutilizan).
PR_CLOSE_SOURCE_BRANCH=true
# {key} = clave del ticket; {summary} = título del ticket con la primera letra en minúscula.
COMMIT_MESSAGE_TEMPLATE=fix({key}): :bug: {summary}
# Credenciales. El token de Jira NO sirve: Bitbucket exige un token de API CON ámbitos de Bitbucket
# (id.atlassian.com → Seguridad → Tokens de API → "Crear token de API con ámbitos" → Bitbucket:
# read:repository, read:pullrequest, write:pullrequest). Email de la cuenta Atlassian (vacío = JIRA_EMAIL).
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
# BITBUCKET_API_BASE=https://api.bitbucket.org/2.0
# Solo si el remoto de los repos no es una URL de bitbucket.org (el slug será el nombre del repo).
# BITBUCKET_WORKSPACE=qrvey

# --- Persistencia y dashboard ------------------------------------------------
# Ruta del archivo SQLite (relativa a la raíz del proyecto o absoluta). Se crea solo.
DATABASE_PATH=./data/bugs-manager.db
# Auth básica del dashboard y su API. Vacíos = sin auth (local). Rellena AMBOS en el VPS.
# No afecta a /slack/events ni /webhooks/jira, que verifican firma.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# --- Repositorios (catálogo) y worktrees -------------------------------------
# Las rutas admiten ~ (home) y rutas relativas a este proyecto.
# Clon de qrvey_platform_knowledge. Aporta: el manifest con los nombres canónicos de los repos de
# producto, el catálogo (docs/catalog) que Claude usa para el triaje, y scripts/setup.sh para clonar
# bajo demanda. Los clones de producto viven en <KNOWLEDGE_REPO_PATH>/repos_product/<repo>.
KNOWLEDGE_REPO_PATH=~/qrvey_platform_knowledge
# Opcionales: sobrescriben las rutas derivadas del repo de conocimiento.
# REPOS_DIR=~/qrvey_platform_knowledge/repos_product
# REPOS_MANIFEST=~/qrvey_platform_knowledge/config/repos_product.manifest
# Repo (ya clonado) contra el que se listan las ramas del desplegable. Vacío = el primero clonado.
BRANCHES_REFERENCE_REPO=
GIT_REMOTE=origin
# Directorio de worktrees. Cada job va a <WORKTREES_DIR>/AN-1234-<timestamp>/<repo>, un worktree
# por repositorio implicado, todos en la misma rama.
WORKTREES_DIR=~/worktree
# Prefijo de la rama de trabajo: fix/AN-1234-<timestamp>. Siempre lleva timestamp, nunca colisiona.
BRANCH_PREFIX=fix/
# Instalación de dependencias en cada worktree. Vacío = autodetectar: package-lock.json → npm ci,
# package.json → npm install, nada → no instalar. Si lo defines, fuerza ese comando en todos.
INSTALL_COMMAND=
INSTALL_TIMEOUT_MINUTES=15
CLONE_TIMEOUT_MINUTES=20
# Archivos a copiar a cada worktree: origen:destino separados por coma. Admite {repo}.
# Origen inexistente → se omite con aviso (no falla). Ej.: COPY_FILES=~/envs/{repo}/.env:.env
COPY_FILES=
# Overrides por repositorio: REPO_<NOMBRE>_INSTALL_COMMAND / _TEST_COMMAND / _COPY_FILES.
# <NOMBRE> es el nombre del manifest en mayúsculas con - y . convertidos a _.
# REPO_ANALYTIQ_WIDGET_COPY_FILES=~/analytiq_widget/.env:.env
# REPO_ANALYTIQ_WIDGET_TEST_COMMAND=npm test -- --watchAll=false
# REPO_ADMIN_PLATFORM_CONFIG_INSTALL_COMMAND=npm install --legacy-peer-deps

# --- Claude Code headless ----------------------------------------------------
# Binario de Claude Code.
CLAUDE_BIN=claude
# AUTENTICACIÓN: el servicio lanza `claude` como tu usuario y hereda estas variables.
# En local NO hace falta nada: usa la sesión de `claude auth login` (llavero de macOS).
# Para el VPS (sin navegador) elige UNA de estas dos y descoméntala:
#  a) Token de larga duración de tu suscripción Claude (Pro/Max/Team). Se genera en tu Mac con
#     `claude setup-token` y se pega aquí. Consume tu plan, no factura aparte.
# CLAUDE_CODE_OAUTH_TOKEN=
#  b) API key de console.anthropic.com. Factura por uso, independiente de la suscripción.
#     Tiene prioridad sobre el login si está definida: no la dejes puesta por accidente en local.
# ANTHROPIC_API_KEY=
# Modelo opcional (vacío = el por defecto de tu cuenta). Ej.: claude-opus-5, claude-sonnet-5
CLAUDE_MODEL=
# acceptEdits: edita archivos sin preguntar; Bash solo lo permitido en CLAUDE_ALLOWED_TOOLS.
CLAUDE_PERMISSION_MODE=acceptEdits
# Comando de tests que Claude debe ejecutar dentro del worktree antes de declarar el fix.
# Vacío = reporta tests:none. Ej.: npm test -- --watchAll=false
TEST_COMMAND=
# Fuentes de settings de Claude Code que carga la sesión: user, project, local.
# Por defecto SOLO "user": el .claude/settings.json del repo puede tener reglas "ask" (p. ej.
# Edit/Write) que en headless nadie puede contestar y bloquean el fix. El servicio inyecta
# igualmente un deny de lectura de .env, *.pem, credenciales, etc.
CLAUDE_SETTING_SOURCES=user
# Listas separadas por coma que SUSTITUYEN las por defecto (ver src/claude/runner.ts).
# Por defecto: edición de archivos + Bash(npm/npx/node/git status|diff|log). Nunca git commit/push.
CLAUDE_ALLOWED_TOOLS=
CLAUDE_DISALLOWED_TOOLS=
# Tope ABSOLUTO por ejecución de Claude (inicio o reanudación). Es red de seguridad, no medida de
# lentitud: un bug difícil (una condición de carrera, por ejemplo) puede llevar una hora de trabajo real.
JOB_TIMEOUT_MINUTES=120
# Colgado de verdad: sin ninguna línea de salida de Claude Code durante este tiempo se mata la sesión
# (se puede reanudar escribiendo en el hilo). Debe superar CLAUDE_BASH_MAX_TIMEOUT_MINUTES, porque un
# test largo en primer plano no emite nada hasta terminar; si no, se ajusta solo.
CLAUDE_IDLE_TIMEOUT_MINUTES=10
# Tope por comando Bash dentro de la sesión. Acota el daño de una espera mal hecha (un bucle
# mirando un archivo inexistente costó 10 min en un job real). El wrapper de Playwright y los tests
# relevantes caben de sobra; súbelo si una suite completa lo necesita.
CLAUDE_BASH_MAX_TIMEOUT_MINUTES=5
# Rondas de needs_clarification permitidas; a la siguiente el job pasa a cannot_fix.
MAX_CLARIFICATION_ROUNDS=3
# Cada fix debe traer un spec DEL REPO que falle sin el fix y pase con él (lo registra bin/unit-run.mjs y lo
# verifica el servicio). Si falta, se le pide a Claude una vez; si sigue sin él, una persona decide en el
# hilo o el dashboard: aceptar sin spec (queda marcado) o descartar. false = solo se informa.
REGRESSION_SPEC_REQUIRED=true

# --- Reproducción en navegador (Playwright) ----------------------------------
# El servicio levanta el dev server del worktree, genera una página de embebido con los
# lanzadores LOCALES y ejecuta el mismo spec antes y después del fix (rojo → verde).
# Requiere una vez por máquina:  pnpm exec playwright install chromium
E2E_ENABLED=true
# Tiempo máximo esperando a que el dev server imprima su URL (una build Stencil es lenta).
DEV_SERVER_TIMEOUT_MINUTES=10
# Dónde se guardan vídeos, capturas y trazas (fuera de los worktrees, sobreviven a la limpieza).
ARTIFACTS_DIR=./data/artifacts
# Ambientes de datos contra los que se monta el widget: TODOS van en environments.json (copia
# environments.example.json y rellénalo; queda fuera de git porque lleva api_keys). Aquí solo se
# elige cuál usar. Si un ambiente falla, cambia este nombre y reinicia el servicio.
# El agente solo pregunta si el elegido no existe, le faltan claves o su dominio no responde.
E2E_ENV=demo
# Ruta del archivo de ambientes (por defecto ./environments.json).
# E2E_ENVIRONMENTS_FILE=./environments.json
# Esquema antiguo por variables, aún admitido: E2E_ENVS=demo,qa más E2E_ENV_DEMO_DOMAIN, _API_KEY,
# _APP_ID, _USER_ID y _QRVEYID por cada nombre (el NOMBRE de las claves debe coincidir, en mayúsculas).
# Por repo (opcional): cómo arrancar la app y dónde dejar el harness si la detección falla.
# REPO_ANALYTIQ_WIDGET_DEV_COMMAND=npm start
# REPO_ANALYTIQ_WIDGET_E2E_HARNESS_DIR=src/html_pages

# --- Slack -------------------------------------------------------------------
# Bot User OAuth Token (OAuth & Permissions → tras instalar la app). Empieza por xoxb-
SLACK_BOT_TOKEN=xoxb-
# Signing Secret (Basic Information → App Credentials). Verifica las peticiones HTTP de Slack.
SLACK_SIGNING_SECRET=
# true  → Socket Mode: sin URL pública, ideal en local. Requiere SLACK_APP_TOKEN.
# false → HTTP: Slack llama a PUBLIC_BASE_URL/slack/events. Recomendado en el VPS.
SLACK_SOCKET_MODE=true
# App-Level Token con scope connections:write (Basic Information → App-Level Tokens). Empieza por xapp-
# Solo necesario si SLACK_SOCKET_MODE=true.
SLACK_APP_TOKEN=xapp-
# ID del canal PRIVADO donde viven los hilos (empieza por C o G). Se obtiene en
# "Ver detalles del canal" → abajo del todo. No es el nombre del canal.
SLACK_CHANNEL_ID=

# =============================================================================
# Fases posteriores (aún no se leen; se documentan para que sepas qué preparar)
# =============================================================================
# --- Fase 6: concurrencia y push opcional (NUNCA merge automático)
# MAX_CONCURRENT_JOBS=3
# ENABLE_PUSH=false
# ENABLE_PR=false
