{
  "name": "bugs-manager",
  "version": "0.1.0",
  "description": "Orquestador Jira → Slack → Claude Code para resolver bugs en worktrees aislados",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "tsx watch --ignore web --ignore dist --ignore data src/index.ts",
    "dev:web": "vite",
    "start": "node dist/index.js",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "simulate:jira": "tsx src/scripts/simulate-jira-webhook.ts",
    "worktrees:cleanup": "tsx src/scripts/cleanup-worktrees.ts",
    "smoke": "node scripts/dev/smoke.mjs",
    "test": "tsx --test src/voice/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
