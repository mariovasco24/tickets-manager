{
  "display_information": {
    "name": "Bugs Manager",
    "description": "Orquesta bugs de Jira con Claude Code y conversa contigo en hilos de Slack",
    "background_color": "#2b2d42"
  },
  "features": {
    "bot_user": {
      "display_name": "bugsmanager",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/fix",
        "description": "Intenta resolver un bug de Jira en un worktree aislado",
        "usage_hint": "AN-1234 [desde develop]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "files:write",
        "groups:history",
        "groups:read",
        "channels:history",
        "channels:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.groups",
        "message.channels"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
